# =============================================================================
# kishan-sahayak Environment Configuration (.env.example)
# =============================================================================
# IMPORTANT:
# - Copy this file to `.env` (never commit real .env files to git)
# - Fill in your actual secrets
# - Load the variables into your shell before running the services
#
# Loading instructions:
#
# Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^=]+)=(.*)$') {
#           $name = $matches[1].Trim()
#           $value = $matches[2].Trim()
#           [System.Environment]::SetEnvironmentVariable($name, $value, 'Process')
#       }
#   }
#
# Or set manually:
#   $env:JWT_SECRET = "..."
#   $env:DB_USERNAME = "root"
#   $env:DB_PASSWORD = "..."
#
# Linux / macOS / Git Bash:
#   export $(grep -v '^#' .env | xargs)
#
# Spring Boot will automatically pick up these OS environment variables
# and use them to replace the ${VAR} placeholders in application.properties.
#
# All services are configured to FAIL FAST if required variables are missing.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Secret (REQUIRED - used by kisan-user and kisan-gateway)
# Must be IDENTICAL in both services.
# Generate a strong 256-bit (or longer) Base64-encoded key for HS256.
# Example generation (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# -----------------------------------------------------------------------------
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# -----------------------------------------------------------------------------
# MariaDB Database Credentials (used by kisan-user, kisan-marketplace, kisan-knowledge)
# All services currently connect to the same local MariaDB instance (localhost:3306).
# Create the databases if they don't exist (the apps use createDatabaseIfNotExist=true).
# -----------------------------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=root

# -----------------------------------------------------------------------------
# Optional: Future per-service DB credentials (uncomment and update properties if needed)
# USER_DB_USERNAME=root
# USER_DB_PASSWORD=root
# MARKETPLACE_DB_USERNAME=root
# MARKETPLACE_DB_PASSWORD=root
# KNOWLEDGE_DB_USERNAME=root
# KNOWLEDGE_DB_PASSWORD=root
# -----------------------------------------------------------------------------
